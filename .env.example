# Chess Shootout — client configuration template.
# Copy this file to ".env" in the same folder and edit what you like. Every key
# is optional: anything omitted uses the default shown, and the in-app menu /
# Options screen writes most of these for you. CLI --client-uuid / --nickname
# override per run. (Server settings live in the deploy gameserver.env — see
# deploy/README.md; they are not part of this client template.)

# ── Online ──────────────────────────────────────────────────────────────────
# Multiplayer server address. "<ip>" uses port 8000; "<ip>:<port>" for a custom
# port; "localhost:8000" for a server on this machine.
CHESS_SERVER_ADDR=localhost:8000

# Display name shown to opponents and written into saved PGNs.
CHESS_NICKNAME=YourName

# Stable per-player id. Auto-generated (UUID4) on first launch — leave blank.
CHESS_CLIENT_UUID=

# Country code for the flag beside your name in online games (e.g. US, RO, JP).
# Set from the Options flag picker; blank = no flag.
CHESS_COUNTRY=

# News feed URL for the menu's News card (JSON array of {title, body, date}).
# No in-app setting for this — hand-edit only. Blank uses the shipped default.
CHESS_NEWS_URL=

# ── Audio (0.0–1.0) ───────────────────────────────────────────────────────────
# Master volume; the in-game slider writes here. Default 0.70.
CHESS_MASTER_VOLUME=0.70

# Menu / battle-backdrop volume; the menu slider writes here. Default 0.10.
CHESS_MENU_VOLUME=0.10

# ── Gameplay defaults (preselected on the setup card) ─────────────────────────
# Default time control in minutes: 1, 3, 5, 10, 15, 30, or ∞ (untimed). Default 10.
CHESS_DEFAULT_TC=10

# Default increment in seconds per move: 0, 2, 5, 10, or 15. Default 5.
CHESS_DEFAULT_INCREMENT=5

# ── Presentation ──────────────────────────────────────────────────────────────
# How the window opens on launch: "windowed" (default size), "maximized", or
# "fullscreen". Set from Options → Display; takes effect on the next launch.
CHESS_LAUNCH_MODE=windowed

# What focus mode (H key) shows on the board: "nothing", "line" (depleting time
# bars on the board edges), or "strips" (full player strips). Default "line".
CHESS_FOCUS_SHOW=line

# ── Performance HUD (Options → Performance) ───────────────────────────────────
# Title-bar FPS readout. Default on.
CHESS_SHOW_FPS=1

# Title-bar ping (online only). Default on.
CHESS_SHOW_PING=1

# Title-bar avg/min FPS readout. Default off.
CHESS_SHOW_FRAME_STATS=0

# Title-bar 1% low FPS readout. Default off.
CHESS_SHOW_1PCT_LOW=0

# Title-bar render-work-per-frame (ms) readout. Default off.
CHESS_SHOW_FRAMETIME=0

# ── Storage ───────────────────────────────────────────────────────────────────
# Folder for saved games, settings, and logs. Blank = per-user default
# (%APPDATA% / ~/Library/Application Support / ~/.local/share); set it from
# Options → Change. The portable Windows build ignores this (uses ./data).
CHESS_DATA_DIR=

# ── Auto-saved / debug (you normally don't set these by hand) ─────────────────
# Last game mode you played; auto-saved so the menu reopens where you left off.
CHESS_LAST_MODE=

# Whether the one-time "Set your name in Profile" hint toast has fired.
# Auto-set on first launch; leave blank to see it again.
CHESS_PROFILE_HINT_SHOWN=

# Debug: 1 draws the menu-battle hitboxes/labels. Off by default.
CHESS_BATTLE_DEBUG=0

# Debug: non-empty logs Win32 resize-sync details on every geometry change.
# Off (blank) by default.
CHESS_DEBUG_RESIZE=
