# Address of the chess server you connect to in online mode.
# Leave blank to use the default (localhost:8000).
CHESS_SERVER_ADDR=localhost:8000

# Display name shown to the opponent. 1-20 printable ASCII chars + spaces.
CHESS_NICKNAME=

# Stable client identity. Auto-generated on first launch if empty.
CHESS_CLIENT_UUID=

# Auto-saved by the client; remembers the last-used start-menu mode
# (single_screen / bot / online).
CHESS_LAST_MODE=

# Master sound volume, 0.00..1.00 inclusive. Default 0.70 on first launch.
CHESS_MASTER_VOLUME=
